{
  "$schema": "https://corrocode.dev/config.json",
  "provider": {
    "corro": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Corro Code",
      "options": {
        "baseURL": "https://corro-code-backend.vercel.app/api",
        "apiKey": "{env:CORRO_JWT}"
      },
      "models": {
        "moonshotai/kimi-k3": { "name": "Kimi K3 (free)" },
        "deepseek-ai/deepseek-v4-flash-0731": { "name": "DeepSeek V4 Flash (free)" },
        "minimaxai/minimax-m3": { "name": "MiniMax M3 (free)" },
        "nvidia/nemotron-3-super-120b-a12b": { "name": "Nemotron 3 Super (free)" }
      }
    }
  }
}
