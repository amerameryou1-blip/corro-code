{
  "$schema": "https://corrocode.dev/desktop-theme.json",
  "provider": {
    "corro": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Corro Code",
      "options": {
        "baseURL": "https://corro-code-backend.vercel.app/api",
        "apiKey": "{env:CORRO_JWT}"
      },
      "models": {
        "moonshotai/kimi-k3": { "name": "Kimi K3 (Corro pool)" },
        "deepseek-ai/deepseek-v4-pro-0813": { "name": "DeepSeek V4 Pro (Corro pool)" },
        "deepseek-ai/deepseek-v4-flash-0731": { "name": "DeepSeek V4 Flash (Corro pool)" }
      }
    }
  }
}
